# Production settings for docker-compose.prod.yml. Copy to .env.production on the
# server, fill in every value, and keep it out of version control. See
# docs/deployment.md.

# The domain the app is served from, without scheme or port. Caddy gets an HTTPS
# certificate for it, and passkeys are bound to it: changing it later invalidates every
# registered passkey.
DOMAIN=app.example.com

# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Sign-in links are emailed through Resend (https://resend.com). The API key needs
# permission to send, and EMAIL_FROM must use a domain verified in Resend, e.g.
# Rich Life <sign-in@app.example.com>.
EMAIL_API_KEY=
EMAIL_FROM=

# Optional; the defaults are shown.
# POSTGRES_USER=richlife
# POSTGRES_DB=richlife
# WEBAUTHN_RP_NAME=Rich Life
# `log` writes sign-in links to the backend's log instead of emailing them: only for a
# local trial.
# EMAIL_DELIVERY=resend
# A git tag or commit SHA, shown in /health.
# APP_VERSION=dev
