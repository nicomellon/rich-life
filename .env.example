# Copy to .env and adjust as needed. docker compose reads .env automatically;
# every value below also has a default in docker-compose.yml.

POSTGRES_USER=richlife
POSTGRES_PASSWORD=richlife
POSTGRES_DB=richlife
POSTGRES_PORT=5432

PGADMIN_PORT=5050

# Backend. The app reads these from the environment only; `make backend` loads
# this file with `uv run --env-file`.
DATABASE_URL=postgresql+psycopg://richlife:richlife@localhost:5432/richlife
# A random string of at least 32 characters; generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-to-a-random-32-plus-char-string
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Frontend dev server. The web app calls /api on its own origin and the dev
# server passes those requests through to this backend. `make frontend` loads
# this file with `node --env-file`.
API_PROXY_TARGET=http://localhost:8000
